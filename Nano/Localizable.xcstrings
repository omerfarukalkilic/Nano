          }
        }
      }
    },
    "Shows a card when a 5h, 7d or plan window passes the line.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 sa, 7 g veya plan penceresi eşiği geçtiğinde bir kart gösterir."
          }
        }
      }
    },
    "Shows the approval or question again with its sound, up to %lld times.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayı veya soruyu sesiyle birlikte en fazla %lld kez yeniden gösterir."
          }
        }
      }
    },
    "Shows the words under the island as you speak": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşurken kelimeleri island'ın altında gösterir"
          }
        }
      }
    },
    "Shows what Quill heard and pasted, and lets you redo it in another style": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill'in duyduğunu ve yapıştırdığını gösterir, başka bir stilde yeniden yapmana izin verir"
          }
        }
      }
    },
    "Shows your 5-hour and weekly limits. Nano reads them from Claude Code's status line, or signs in with your Claude Code credentials and asks Anthropic. It stores only the percentages and reset times.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saatlik ve haftalık limitlerini gösterir. Nano bunları Claude Code'un durum satırından okur ya da Claude Code kimlik bilgilerinle oturum açıp Anthropic'e sorar. Yalnızca yüzdeleri ve sıfırlanma zamanlarını saklar."
          }
        }
      }
    },
    "Size": {
