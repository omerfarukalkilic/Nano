    },
    "Vocabulary and snippets": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlük ve snippet'ler"
          }
        }
      }
    },
    "Vocabulary booster": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlük güçlendirici"
          }
        }
      }
    },
    "Vocabulary sets how a word is spelled. A snippet swaps a phrase you say for text you wrote. Double-click an entry to edit it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlük bir kelimenin nasıl yazılacağını belirler. Snippet, söylediğin bir ifadeyi yazdığın metinle değiştirir. Düzenlemek için girişe çift tıkla."
          }
        }
      }
    },
    "Volume is set on the device": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses düzeyi aygıtta ayarlanır"
          }
        }
      }
    },
    "Volume unavailable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses düzeyi kullanılamıyor"
          }
        }
