        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, indirme bitmeden koptu."
          }
        }
      }
    },
    "The current output device does not expose a master volume.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çıkış aygıtında ana ses düzeyi ayarı yok."
          }
        }
      }
    },
    "The dashboard stays closed until you click the island.": {
      "localizations": {
