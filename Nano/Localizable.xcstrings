      }
    },
    "The transcript is too long for one cleanup pass.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin tek seferde düzenlemek için çok uzun."
          }
        }
      }
    },
    "The update information couldn't be read": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme bilgisi okunamadı"
          }
        }
      }
    },
    "The update server answered %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme sunucusu %lld yanıtı verdi"
          }
        }
      }
    },
    "Their images are deleted too. Open cues aren't touched.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görselleri de silinir. Açık cue'lara dokunulmaz."
          }
        }
      }
    },
    "Then a %lld min break": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra %lld dk mola"
          }
        }
      }
    },
    "Then back to it": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra işe dön"
          }
        }
      }
    },
    "Then turn it on. Nano reopens when macOS asks.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından anahtarı aç. macOS isterse Nano yeniden açılır."
          }
        }
      }
    },
    "They replace the macOS ones. Press a volume key to try.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'unkilerin yerini alır. Denemek için bir ses tuşuna bas."
          }
        }
      }
    },
