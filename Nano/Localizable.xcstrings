            "value": "Agent turunu tamamladı."
          }
        }
      }
    },
    "The camera stopped unexpectedly.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera beklenmedik şekilde durdu."
          }
        }
      }
    },
    "The camera turns on only while you look at it. Nothing is recorded.": {
      "localizations": {
        "tr": {
