      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık"
          }
        }
      }
    },
    "On battery": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil gücüyle"
          }
        }
      }
    },
    "On my way — save me a seat.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoldayım, bana yer ayır."
          }
        }
      }
