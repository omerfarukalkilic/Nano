          }
        }
      }
    },
    "Shows a card when a 5h, 7d or plan window passes the line.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 sa, 7 g veya plan penceresi eşiği aşınca kart gösterir."
          }
        }
      }
    },
    "Shows battery when your AirPods or other devices connect. macOS asks for Bluetooth to do this.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods veya başka aygıtlar bağlandığında pil durumunu gösterir. macOS bunun için Bluetooth izni ister."
          }
        }
      }
    },
    "Shows the approval or question again with its sound, up to %lld times.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayı veya soruyu sesiyle birlikte en fazla %lld kez yeniden gösterir."
          }
        }
      }
    },
    "Shows the words under the island as you speak": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşurken kelimeleri island'ın altında gösterir"
          }
        }
      }
    },
    "Shows what Quill heard and pasted, and lets you redo it in another style": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill'in duyduğunu ve yapıştırdığını gösterir; başka bir stilde yeniden yapılabilir"
          }
        }
      }
    },
    "Shows your 5-hour and weekly limits. Nano reads them from Claude Code's status line, or signs in with your Claude Code credentials and asks Anthropic. It stores only the percentages and reset times.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
