            "value": "Bu ay, çoğunlukla şuradan: %@ ve %@"
          }
        }
      }
    },
    "This output's audio format isn't supported. Choose a stereo output, then retry.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çıkışın ses biçimi desteklenmiyor. Stereo bir çıkış seç, sonra yeniden dene."
