          "stringUnit": {
            "state": "translated",
            "value": "Çalışıyor"
          }
        }
      }
    },
    "Working in %lld %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ üzerinde çalışıyor"
          }
        }
      }
    },
    "You changed ": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirdin: "
          }
        }
      }
    },
    "You changed “%@” to “%@” %@. Write it that way from now on?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You changed “%1$@” to “%2$@” %3$@. Write it that way from now on?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ifadesini %3$@ “%2$@” olarak değiştirdin. Bundan sonra böyle yazılsın mı?"
          }
        }
      }
    },
    "You deleted ": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sildin: "
          }
        }
      }
    },
    "You deleted “%@” %@. Leave it out from now on?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You deleted “%1$@” %2$@. Leave it out from now on?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ifadesini %2$@ sildin. Bundan sonra atlansın mı?"
          }
        }
      }
    },
    "You have %@. The download opens in your browser.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende %@ var. İndirme tarayıcında açılır."
          }
        }
      }
    },
    "You open Nano yourself after a restart.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden başlatmadan sonra Nano'yu kendin açarsın."
          }
        }
      }
    },
    "You said ": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şunu dedin: "
          }
        }
      }
    },
    "You said “%@” and deleted what came before it %@. Treat it as changing your mind?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You said “%1$@” and deleted what came before it %2$@. Treat it as changing your mind?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” dedin ve öncesini %2$@ sildin. Bu, fikir değiştirme olarak algılansın mı?"
          }
        }
      }
    },
    "You're set.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırsın."
          }
        }
      }
    },
    "Your current layout is replaced.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut düzenin değiştirilir."
          }
        }
      }
    },
    "Your dashboard is empty.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panon boş."
          }
        }
      }
    },
    "Your own app, or any app with tasks. Give its developer or coding agent the setup guide, then connect it here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi uygulaman ya da görev içeren herhangi bir uygulama. Kurulum rehberini geliştiricisine ya da kodlama agent'ına ver, sonra buradan bağla."
          }
        }
      }
    },
    "[Sketch 0:42 · video and screenshots in ~/Library/Caches/Nano/Sketches/…]\n- #1 (0:03) “This button is misaligned.”\n- #2 (0:09) [clicked] “Now the menu opens under it.”\n- #3 (0:15) “[1] This header [2] and this one should be bold.”": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Sketch 0:42 · video ve ekran görüntüleri ~/Library/Caches/Nano/Sketches/… içinde]\n- #1 (0:03) “Bu düğme hizalı değil.”\n- #2 (0:09) [tıklandı] “Şimdi menü altında açılıyor.”\n- #3 (0:15) “[1] Bu başlık [2] ve bu kalın olmalı.”"
          }
        }
      }
    },
