    "The sign-in reply didn't match the request, so Nano ignored it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma yanıtı istekle eşleşmedi, Nano yanıtı yok saydı."
          }
        }
      }
    },
    "The transcript is kept in Nano. Open Quill in the island and press Copy.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin Nano'da saklandı. Island'da Quill'i aç ve Kopyala'ya bas."
          }
