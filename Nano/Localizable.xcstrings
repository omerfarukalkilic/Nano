    "Off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        }
      }
    },
    "Off keeps Nano on the display where you last placed it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken Nano son yerleştirdiğin ekranda kalır."
          }
        }
      }
    },
    "Off, so a web page can't start recording. Stop and cancel always work": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı; böylece bir web sayfası kaydı başlatamaz. Durdurma ve iptal her zaman çalışır"
          }
        }
      }
    },
    "Off: Codex asks in its own window and Nano shows that it's waiting. Codex's auto-review always decides on its own.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: Codex kendi penceresinde sorar, Nano da beklediğini gösterir. Codex'in otomatik incelemesi her zaman kendi kararını verir."
          }
        }
      }
    },
